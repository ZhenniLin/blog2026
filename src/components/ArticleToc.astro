---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Node extends Heading {
  children: Node[];
}
interface Props { headings: Heading[] }

const roots: Node[] = [];
const stack: Node[] = [];
for (const heading of Astro.props.headings) {
  if (heading.depth < 2 || heading.depth > 4) continue;
  const node: Node = { ...heading, children: [] };
  while (stack.length && stack[stack.length - 1].depth >= node.depth) stack.pop();
  if (stack.length) stack[stack.length - 1].children.push(node);
  else roots.push(node);
  stack.push(node);
}
---

{roots.length > 0 && (
  <aside class="article-toc pixel-box" aria-label="文章目录">
    <details open>
      <summary><span class="toc-label">文章目录</span></summary>
      <button class="toc-collapse" type="button" aria-label="收起目录">收起 ↑</button>
      <nav aria-label="章节导航">
        <ul role="list">
          {roots.map((section) => (
            <li>
              <a href={`#${section.slug}`}>{section.text}</a>
              {section.children.length > 0 && (
                <ul role="list">
                  {section.children.map((child) => (
                    <li>
                      <a href={`#${child.slug}`}>{child.text}</a>
                      {child.children.length > 0 && (
                        <ul role="list">
                          {child.children.map((leaf) => (
                            <li><a href={`#${leaf.slug}`}>{leaf.text}</a></li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <button class="toc-resize" type="button" aria-label="调整目录高度" title="向下拖动增加高度，也可用上下方向键调整">
        <span aria-hidden="true"></span>
      </button>
    </details>
  </aside>
)}

<script>
  const compact = window.matchMedia('(max-width: 999px)');
  const syncToc = () => {
    document.querySelectorAll<HTMLDetailsElement>('.article-toc details').forEach((details) => {
      details.open = !compact.matches;
    });
  };
  syncToc();
  compact.addEventListener('change', syncToc);

  document.querySelectorAll<HTMLElement>('.article-toc').forEach((toc) => {
    const details = toc.querySelector<HTMLDetailsElement>('details');
    let openedByHover = false;
    toc.addEventListener('pointerenter', (event) => {
      if (!compact.matches || event.pointerType !== 'mouse' || !details) return;
      openedByHover = !details.open;
      details.open = true;
    });
    toc.addEventListener('pointerleave', (event) => {
      if (!compact.matches || event.pointerType !== 'mouse' || !details) return;
      openedByHover = false;
      details.open = false;
    });
    details?.querySelector('summary')?.addEventListener('click', (event) => {
      // 悬停已打开时，点击钩子不应立即把目录关闭。
      if (compact.matches && openedByHover && details.open) event.preventDefault();
    });
    document.addEventListener('pointerdown', (event) => {
      if (compact.matches && details && !toc.contains(event.target as Node)) details.open = false;
    });
    toc.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && compact.matches && details) {
        details.open = false;
        openedByHover = false;
        details.querySelector('summary')?.focus();
      }
    });
    toc.querySelector<HTMLButtonElement>('.toc-collapse')?.addEventListener('click', () => {
      if (!details) return;
      details.open = false;
      details.querySelector('summary')?.focus();
    });
    const nav = toc.querySelector<HTMLElement>('nav');
    const handle = toc.querySelector<HTMLButtonElement>('.toc-resize');
    if (!nav || !handle) return;
    const sections = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
      .map((link) => ({
        link,
        heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
      }))
      .filter((section): section is { link: HTMLAnchorElement; heading: HTMLElement } => !!section.heading);
    let activeLink: HTMLAnchorElement | undefined;
    const revealActive = () => {
      if (!activeLink || !details?.open || nav.clientHeight === 0) return;
      const bounds = nav.getBoundingClientRect();
      const linkBounds = activeLink.getBoundingClientRect();
      if (linkBounds.top < bounds.top + 8) {
        nav.scrollTop += linkBounds.top - bounds.top - 8;
      } else if (linkBounds.bottom > bounds.bottom - 8) {
        nav.scrollTop += linkBounds.bottom - bounds.bottom + 8;
      }
    };
    const syncActive = () => {
      if (!sections.length) return;
      let current = sections[0];
      // 与章节跳转时的顶部留白配合，标题经过阅读区顶部后切换。
      for (const section of sections) {
        if (section.heading.getBoundingClientRect().top > 120) break;
        current = section;
      }
      if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) {
        current = sections[sections.length - 1];
      }
      if (current.link === activeLink) return;
      activeLink?.removeAttribute('aria-current');
      activeLink = current.link;
      activeLink.setAttribute('aria-current', 'location');
      revealActive();
    };
    let scrollFrame = 0;
    const scheduleSync = () => {
      if (scrollFrame) return;
      scrollFrame = requestAnimationFrame(() => {
        scrollFrame = 0;
        syncActive();
      });
    };
    window.addEventListener('scroll', scheduleSync, { passive: true });
    window.addEventListener('resize', scheduleSync);
    details?.addEventListener('toggle', revealActive);
    new ResizeObserver(revealActive).observe(nav);
    syncActive();
    let pointerId: number | null = null;
    let startY = 0;
    let startHeight = 0;
    const resize = (height: number) => {
      const maximum = Number.parseFloat(getComputedStyle(nav).maxHeight);
      const minimum = Number.parseFloat(getComputedStyle(nav).minHeight);
      nav.style.height = `${Math.max(minimum, Math.min(maximum, height))}px`;
    };
    handle.addEventListener('pointerdown', (event) => {
      if (event.button !== 0) return;
      pointerId = event.pointerId;
      startY = event.clientY;
      startHeight = nav.getBoundingClientRect().height;
      handle.setPointerCapture(event.pointerId);
      event.preventDefault();
    });
    handle.addEventListener('pointermove', (event) => {
      if (event.pointerId === pointerId) resize(startHeight + event.clientY - startY);
    });
    const stopResize = () => { pointerId = null; };
    handle.addEventListener('lostpointercapture', stopResize);
    handle.addEventListener('pointerup', stopResize);
    handle.addEventListener('pointercancel', stopResize);
    handle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      resize(nav.getBoundingClientRect().height + (event.key === 'ArrowDown' ? 24 : -24));
    });
  });
</script>

<style>
  .article-toc {
    position: fixed;
    z-index: 10;
    top: min(240px, 26vh);
    right: calc(50% + var(--w-page) / 2 + 64px);
    width: 210px;
    padding: 14px;
    font-family: var(--font-reading);
    font-size: 12px;
    line-height: 1.65;
  }
  summary {
    cursor: pointer;
    color: var(--c-orange-dark);
    font-size: 13px;
    font-weight: 600;
  }
  .toc-collapse {
    display: none;
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 3px 6px;
    font: inherit;
    color: var(--c-orange-dark);
    border: 1px solid var(--c-line);
    background: var(--c-panel);
    cursor: pointer;
  }
  .toc-collapse:hover { background: var(--c-hover); border-color: var(--c-orange); }
  nav {
    height: 280px;
    min-height: min(140px, max(80px, calc(100dvh - min(240px, 26vh) - 100px)));
    max-height: max(80px, calc(100dvh - min(240px, 26vh) - 100px));
    overflow-y: auto;
    padding-right: 10px;
    scrollbar-gutter: stable;
    margin-top: 10px;
    scrollbar-width: auto;
    scrollbar-color: auto;
    overscroll-behavior: contain;
  }
  nav::-webkit-scrollbar {
    width: 8px;
  }
  nav::-webkit-scrollbar-track {
    background: var(--c-hover);
    border-left: 1px solid var(--c-line);
  }
  nav::-webkit-scrollbar-thumb {
    background: #d8c3a5;
    border: 1px solid #b89e7d;
    border-radius: 0;
  }
  nav::-webkit-scrollbar-thumb:hover {
    background: #c5ad8d;
  }
  nav::-webkit-scrollbar-button {
    display: none;
    width: 0;
    height: 0;
  }
  @supports (-moz-appearance: none) {
    nav {
      scrollbar-width: thin;
      scrollbar-color: #c5ad8d var(--c-hover);
    }
  }
  .toc-resize {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 18px;
    margin-top: 12px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: ns-resize;
    touch-action: none;
  }
  .toc-resize span {
    flex: none;
    width: 24px;
    height: 10px;
    background:
      repeating-linear-gradient(90deg, var(--c-amber) 0 3px, transparent 3px 7px) top / 100% 3px no-repeat,
      repeating-linear-gradient(90deg, var(--c-orange) 0 3px, transparent 3px 7px) bottom / 100% 3px no-repeat;
  }
  .toc-resize::before,
  .toc-resize::after {
    content: '';
    flex: 1;
    height: 1px;
    margin: 0 10px;
    background: var(--c-line);
  }
  .toc-resize:hover,
  .toc-resize:active {
    background: var(--c-hover);
  }
  .toc-resize:focus-visible {
    outline: 1px solid var(--c-orange);
    outline-offset: 2px;
  }
  ul, li {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li::marker { content: ''; }
  ul ul {
    margin: 3px 0 8px 10px;
    padding-left: 10px;
    border-left: 2px solid var(--c-line);
  }
  a {
    display: block;
    padding: 5px 2px;
    color: var(--c-orange-dark);
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  a:hover, a:focus-visible {
    background: var(--c-hover);
    color: var(--c-orange-dark);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  a[aria-current='location'] {
    background: var(--c-hover);
    box-shadow: inset 2px 0 #b89e7d;
    padding-left: 7px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 1000px) and (max-width: 1199px) {
    .article-toc {
      right: calc(50% + var(--w-page) / 2 + 24px);
      width: calc(50vw - var(--w-page) / 2 - 32px);
      padding: 10px;
    }
  }
  @media (max-width: 999px) {
    .article-toc {
      left: 0;
      right: auto;
      width: 24px;
      padding: 0;
      border-left: 0;
    }
    .article-toc:not(:has(details[open])) {
      border-color: #d8c3a5;
      border-right-color: #b89e7d;
      background: var(--c-panel);
      clip-path: polygon(0 0, calc(100% - 4px) 0, calc(100% - 4px) 4px, 100% 4px, 100% calc(100% - 4px), calc(100% - 4px) calc(100% - 4px), calc(100% - 4px) 100%, 0 100%);
    }
    .article-toc:not(:has(details[open])) summary {
      height: 44px;
      align-items: center;
    }
    .article-toc:not(:has(details[open])) summary::after {
      content: '';
      width: 12px;
      height: 14px;
      background: repeating-linear-gradient(
        to bottom,
        var(--c-orange-dark) 0 2px,
        transparent 2px 6px
      );
    }
    .article-toc:not(:has(details[open])) .toc-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    summary {
      display: flex;
      justify-content: center;
      list-style: none;
    }
    .toc-label {
      writing-mode: vertical-rl;
      letter-spacing: 0.35em;
      line-height: 1;
    }
    summary::-webkit-details-marker { display: none; }
    nav { display: none; }
    .article-toc:has(details[open]) {
      width: min(230px, calc(100vw - 32px));
      padding: 14px;
    }
    .article-toc:has(details[open]) summary {
      justify-content: flex-start;
      padding-right: 60px;
    }
    .article-toc:has(details[open]) .toc-label {
      writing-mode: horizontal-tb;
      letter-spacing: normal;
      line-height: 1.65;
    }
    .article-toc:has(details[open]) .toc-collapse { display: block; }
    .article-toc:has(details[open]) nav { display: block; }
  }
</style>
