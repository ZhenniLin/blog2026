---
import { SITE } from '../config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <span class="blocks" aria-hidden="true">
      <i></i><i></i><i></i>
    </span>
    <p class="visitor-count">
      已有 <span id="visitor-count" aria-live="polite">统计中…</span> 位访客来过
    </p>
    <p>© {year} {SITE.title} · Made with Astro</p>
  </div>
</footer>

<script is:inline>
  (() => {
    const countElement = document.getElementById('visitor-count');
    if (!countElement) return;

    const counterUrl = 'https://api.counterapi.dev/v1/zhenni-blog2026/site-visitors';
    const visitorMarker = 'blog2026-visitor-counted-at-v1';
    const visitorWindow = 24 * 60 * 60 * 1000;
    let requestUrl = `${counterUrl}/`;
    let markedThisVisit = false;

    try {
      const lastCountedAt = Number(localStorage.getItem(visitorMarker));
      const canCountAgain = !Number.isFinite(lastCountedAt)
        || Date.now() - lastCountedAt >= visitorWindow;

      if (canCountAgain) {
        localStorage.setItem(visitorMarker, String(Date.now()));
        requestUrl = `${counterUrl}/up`;
        markedThisVisit = true;
      }
    } catch {
      // 无法使用本地存储时只读取计数，避免每次刷新都重复增加。
    }

    fetch(requestUrl, { cache: 'no-store' })
      .then((response) => {
        if (!response.ok) throw new Error(`Counter request failed: ${response.status}`);
        return response.json();
      })
      .then((data) => {
        if (typeof data.count !== 'number') throw new Error('Counter response is invalid');
        countElement.textContent = data.count.toLocaleString('zh-CN');
      })
      .catch(() => {
        if (markedThisVisit) {
          try {
            localStorage.removeItem(visitorMarker);
          } catch {
            // 本地存储不可用时无需继续处理。
          }
        }
        countElement.textContent = '暂不可用';
      });
  })();
</script>

<style>
  .site-footer {
    margin-top: 40px;
    padding: 20px 0 28px;
    border-top: 3px solid var(--c-line);
    text-align: center;
    font-size: 12px;
    color: var(--c-muted);
  }

  p {
    margin: 10px 0 0;
  }

  .visitor-count {
    color: var(--c-mint);
    font-family: var(--font-pixel);
    font-size: 10px;
  }

  .blocks {
    display: inline-flex;
    gap: 5px;
  }

  .blocks i {
    width: 10px;
    height: 10px;
    display: block;
    animation: pop 1.2s steps(1, end) infinite;
  }

  .blocks i:nth-child(1) {
    background: var(--c-orange);
  }
  .blocks i:nth-child(2) {
    background: var(--c-amber);
    animation-delay: 0.4s;
  }
  .blocks i:nth-child(3) {
    background: var(--c-mint);
    animation-delay: 0.8s;
  }

  /* 三个方块依次跳一下 */
  @keyframes pop {
    0%,
    32.99% {
      transform: translateY(-3px);
    }
    33%,
    100% {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blocks i {
      animation: none;
    }
  }
</style>
