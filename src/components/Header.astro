---
import { SITE } from '../config';

const links = [
  { href: '/about/', label: '关于' },
  { href: '/articles/', label: '文章' },
  { href: '/daily/', label: '日常' },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/">
      <!-- 会翻面的像素金币 -->
      <span class="coin" aria-hidden="true"></span>
      <span class="logo-text">{SITE.title.toUpperCase()}</span>
    </a>

    <nav aria-label="主导航">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={['nav-link', { active: isActive(link.href) }]}
                aria-current={isActive(link.href) ? 'page' : undefined}
              >
                <span class="cursor" aria-hidden="true">
                  ▶
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--c-panel);
    border-bottom: 4px solid var(--c-orange);
  }

  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .coin {
    display: inline-block;
    width: 13px;
    height: 13px;
    flex: none;
    background: var(--c-amber);
    border: 2px solid var(--c-orange);
    box-shadow: inset -3px -3px 0 var(--c-orange-dark);
    animation: flip 2s step-end infinite;
  }

  /* 用 scaleX 模拟金币翻面，step-end 保证是「跳帧」而不是平滑缩放 */
  @keyframes flip {
    0%,
    100% {
      transform: scaleX(1);
    }
    40% {
      transform: scaleX(0.15);
    }
    50% {
      transform: scaleX(1);
    }
    90% {
      transform: scaleX(0.15);
    }
  }

  .logo-text {
    font-family: var(--font-pixel);
    font-size: 11px;
    color: var(--c-orange);
    letter-spacing: 0.06em;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-link {
    position: relative;
    display: inline-block;
    font-size: 14px;
    color: var(--c-muted);
    transition: color 0.1s;
  }

  .cursor {
    position: absolute;
    left: -15px;
    top: 1px;
    font-size: 9px;
    color: var(--c-amber);
    opacity: 0;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--c-orange);
  }

  .nav-link:hover .cursor,
  .nav-link.active .cursor {
    opacity: 1;
    animation: blink-cursor 0.8s steps(1, end) infinite;
  }

  @keyframes blink-cursor {
    0%,
    49.99% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0.25;
    }
  }

  @media (max-width: 480px) {
    .logo-text {
      font-size: 9px;
    }

    nav ul {
      gap: 14px;
    }

    .nav-link {
      font-size: 13px;
    }

    .cursor {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coin,
    .nav-link:hover .cursor,
    .nav-link.active .cursor {
      animation: none;
    }
  }
</style>
