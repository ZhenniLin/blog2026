---
import { formatYM } from '../utils/date';

interface Props {
  href: string;
  title: string;
  date: Date;
  category?: string;
}

const { href, title, date, category } = Astro.props;
---

<a class="row-link pixel-box" href={href} data-category={category}>
  <span class="row-title">
    <span class="arrow" aria-hidden="true">▶</span>
    <span>{title}</span>
  </span>
  <time class="row-date" datetime={date.toISOString()}>{formatYM(date)}</time>
</a>
