---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DailyEntry from '../../components/DailyEntry.astro';
import PixelSprite from '../../components/PixelSprite.astro';
import { byDateDesc } from '../../utils/date';

const daily = (await getCollection('daily', ({ data }) => !data.draft))
  .sort(byDateDesc);
---

<BaseLayout title="日常记录" description="日常记录">
  <div class="wrap page">
    <h1 class="page-title">
      <PixelSprite name="coffee" size={30} />
      日常记录
    </h1>

    {daily.map((entry) => <DailyEntry entry={entry} />)}
    {daily.length === 0 && <p class="empty">日常还没开始记录 :)</p>}
  </div>
</BaseLayout>
